    mode: 0
    demo: 0
    priority: 0
    volume: 1
    cooldown: 0
    assisted: 1
    controllerTarget: 
    rightHand: 0
    controllerAnimation: {fileID: 0}
    transcript: Watch the water bar by your plant. The target shows how much it needs.
      Stop pouring when you reach it to avoid wasting water.
    instruction: Watch the plant's water bar.
    instructionDetail: Stop pouring at the target.
    steps: []
  - id: 06_enough_water
